# Local startup also accepts this computer's LAN IPs and prints device URLs.
# Keep NODE_ENV unset/development for local HTTP testing.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
TMDB_API_KEY=
# Optional: persistent disk directory containing separate app databases and uploads.
# Omit locally to retain the existing project databases.
# PORTFOLIO_DATA_DIR=./data
# Optional Movieshub Google login callback:
# GOOGLE_REDIRECT_URI=https://your-domain.example/movieshub/api/auth/google/callback
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# RAWG supplies posters and gameplay screenshots (server-only).
RAWG_API_KEY=
