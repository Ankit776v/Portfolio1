MONGODB_URI=mongodb://127.0.0.1:27017/movieshub
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development

# Google Cloud OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Resend email credentials (used to send password-reset emails)
RESEND_API_KEY=
EMAIL_FROM=Movieshub <onboarding@resend.dev>

# Server-side key for automatically refreshed live listings
TMDB_API_KEY=

# Set only when behind a known reverse proxy; never blindly trust all proxies.
TRUST_PROXY_HOPS=
